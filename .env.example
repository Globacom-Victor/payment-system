# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_payment

# Ethereum API Configuration (Get free key at https://etherscan.io)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# CoinGecko API Configuration (No key needed - free API)
COINGECKO_CACHE_TTL=60

# Email Configuration (Gmail Example)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an app password
# 3. Use it below (NOT your regular Gmail password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True
SMTP_NAME=Crypto Payment System

# Notification Settings
NOTIFICATIONS_ENABLED=True
ADMIN_EMAIL=admin@example.com
NOTIFY_CUSTOMER=True
NOTIFY_ADMIN=True

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO
